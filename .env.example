# GOOGLE_MAPS_API_KEY: Places API key used to retrieve real Google Maps businesses.
# Enable Places API (New) and restrict it to this Android application in Google Cloud.
GOOGLE_MAPS_API_KEY=MY_GOOGLE_MAPS_API_KEY

# GEMINI_API_KEY: Required for Gemini AI API calls with Search and Maps grounding & Live voice.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY
